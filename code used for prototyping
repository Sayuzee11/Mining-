// =====================================================
// SETUP
// =====================================================

void setup()
{
  Serial.begin(115200);

  delay(1000);

  Serial.println();
  Serial.println("================================");
  Serial.println("MINE GROUND MONITOR");
  Serial.println("================================");

  // -------------------------------------------------
  // I2C
  // -------------------------------------------------

  Wire.begin(
    SDA_PIN,
    SCL_PIN
  );

  // -------------------------------------------------
  // MPU6050
  // -------------------------------------------------

  if (!mpu.begin())
  {
    Serial.println("MPU6050 NOT FOUND!");

    while (1)
    {
      delay(1000);
    }
  }

  Serial.println("MPU6050 connected.");

  // MPU configuration
  mpu.setAccelerometerRange(
    MPU6050_RANGE_8_G
  );

  mpu.setGyroRange(
    MPU6050_RANGE_500_DEG
  );

  mpu.setFilterBandwidth(
    MPU6050_BAND_21_HZ
  );

  // -------------------------------------------------
  // VIBRATION SENSOR
  // -------------------------------------------------

  pinMode(
    VIBRATION_PIN,
    INPUT
  );

  // -------------------------------------------------
  // CALIBRATION
  // -------------------------------------------------

  calibrateMPU();

  // -------------------------------------------------
  // WIFI
  // -------------------------------------------------

  WiFi.mode(WIFI_AP_STA);

  WiFi.begin(
    WIFI_SSID,
    WIFI_PASSWORD
  );

  Serial.print("Connecting to WiFi");

  unsigned long wifiStart =
    millis();

  while (
    WiFi.status() != WL_CONNECTED &&
    millis() - wifiStart < 15000
  )
  {
    delay(500);

    Serial.print(".");
  }

  Serial.println();

  if (WiFi.status() == WL_CONNECTED)
  {
    Serial.println("WiFi connected.");

    Serial.print("WiFi IP: ");
    Serial.println(
      WiFi.localIP()
    );
  }
  else
  {
    Serial.println(
      "WiFi connection failed."
    );

    Serial.println(
      "Telegram will not work until internet is available."
    );
  }

  // -------------------------------------------------
  // ESP32 ACCESS POINT
  // -------------------------------------------------

  WiFi.softAP(
    AP_SSID,
    AP_PASSWORD
  );

  Serial.println();
  Serial.println("ESP32 Access Point started.");

  Serial.print("AP Name: ");
  Serial.println(AP_SSID);

  Serial.print("AP IP: ");
  Serial.println(
    WiFi.softAPIP()
  );

  // -------------------------------------------------
  // TELEGRAM HTTPS
  // -------------------------------------------------

  telegramClient.setInsecure();

  // -------------------------------------------------
  // TELEGRAM STARTUP MESSAGE
  // -------------------------------------------------

  if (WiFi.status() == WL_CONNECTED)
  {
    bool sent =
      bot.sendMessage(
        CHAT_ID,
        "✅ Mine Ground Monitor is ONLINE.\n\nSensor monitoring has started.",
        ""
      );

    if (sent)
    {
      Serial.println(
        "Telegram startup message sent."
      );
    }
    else
    {
      Serial.println(
        "Telegram startup message failed."
      );
    }
  }

  // -------------------------------------------------
  // WEB SERVER
  // -------------------------------------------------

  server.on(
    "/",
    handleRoot
  );

  server.begin();

  Serial.println(
    "Web server started."
  );

  Serial.println();
  Serial.println(
    "================================"
  );

  Serial.print(
    "Dashboard: http://"
  );

  Serial.println(
    WiFi.softAPIP()
  );

  Serial.println(
    "================================"
  );
}

// =====================================================
// LOOP
// =====================================================

void loop()
{
  server.handleClient();

  unsigned long currentTime =
    millis();

  if (
    currentTime - previousSensorTime
    >= SENSOR_INTERVAL
  )
  {
    float dt =
      (currentTime - previousSensorTime)
      / 1000.0;

    previousSensorTime =
      currentTime;

    // -----------------------------------------------
    // Read sensors
    // -----------------------------------------------

    readMPU();

    readVibration();

    // -----------------------------------------------
    // Calculate tilt rate
    // -----------------------------------------------

    calculateTiltRate(dt);

    // -----------------------------------------------
    // Calculate risk
    // -----------------------------------------------

    calculateRisk();

    // -----------------------------------------------
    // Telegram alert
    // -----------------------------------------------

    if (WiFi.status() == WL_CONNECTED)
    {
      checkTelegramAlert();
    }

    // -----------------------------------------------
    // Serial monitor
    // -----------------------------------------------

    Serial.print("Tilt: ");
    Serial.print(groundTilt, 2);

    Serial.print(" | Vibration: ");
    Serial.print(vibrationPercent, 1);

    Serial.print("% | Tilt Rate: ");
    Serial.print(tiltRate, 2);

    Serial.print(" | Risk: ");
    Serial.print(riskScore, 1);

    Serial.print(" | Status: ");
    Serial.println(groundStatus);
  }
}
