// =====================================================
// TELEGRAM ALERT VARIABLES
// =====================================================

int criticalCount = 0;

const int CRITICAL_COUNT_REQUIRED = 5;

bool criticalAlertSent = false;

// =====================================================
// TIMING
// =====================================================

unsigned long previousSensorTime = 0;

const unsigned long SENSOR_INTERVAL = 200;

// =====================================================
// CALIBRATION
// =====================================================

void calibrateMPU()
{
  Serial.println();
  Serial.println("================================");
  Serial.println("MPU6050 CALIBRATION");
  Serial.println("Keep the sensor completely still.");
  Serial.println("================================");

  delay(2000);

  float pitchSum = 0;
  float rollSum = 0;

  const int samples = 100;

  for (int i = 0; i < samples; i++)
  {
    sensors_event_t a, g, temp;

    mpu.getEvent(&a, &g, &temp);

    float p = atan2(
      a.acceleration.y,
      sqrt(
        a.acceleration.x * a.acceleration.x +
        a.acceleration.z * a.acceleration.z
      )
    ) * 180.0 / PI;

    float r = atan2(
      -a.acceleration.x,
      a.acceleration.z
    ) * 180.0 / PI;

    pitchSum += p;
    rollSum += r;

    delay(20);
  }

  pitchOffset = pitchSum / samples;
  rollOffset = rollSum / samples;

  Serial.println("Calibration complete.");

  Serial.print("Pitch Offset: ");
  Serial.println(pitchOffset);

  Serial.print("Roll Offset: ");
  Serial.println(rollOffset);

  Serial.println();
}

// =====================================================
// READ MPU6050
// =====================================================

void readMPU()
{
  sensors_event_t a, g, temp;

  mpu.getEvent(&a, &g, &temp);

  float rawPitch = atan2(
    a.acceleration.y,
    sqrt(
      a.acceleration.x * a.acceleration.x +
      a.acceleration.z * a.acceleration.z
    )
  ) * 180.0 / PI;

  float rawRoll = atan2(
    -a.acceleration.x,
    a.acceleration.z
  ) * 180.0 / PI;

  pitch = rawPitch - pitchOffset;
  roll = rawRoll - rollOffset;

  groundTilt = sqrt(
    pitch * pitch +
    roll * roll
  );
}

// =====================================================
// READ VIBRATION
// =====================================================

void readVibration()
{
  int vibrationCount = 0;

  const int samples = 100;

  for (int i = 0; i < samples; i++)
  {
    if (digitalRead(VIBRATION_PIN) == HIGH)
    {
      vibrationCount++;
    }

    delay(1);
  }

  vibrationPercent =
    ((float)vibrationCount / samples) * 100.0;

  if (vibrationPercent > 100)
    vibrationPercent = 100;

  if (vibrationPercent < 0)
    vibrationPercent = 0;
}

// =====================================================
// CALCULATE TILT RATE
// =====================================================

void calculateTiltRate(float dt)
{
  if (dt <= 0)
    return;

  tiltRate =
    abs(groundTilt - previousTilt) / dt;

  previousTilt = groundTilt;
}

// =====================================================
// CALCULATE RISK
// =====================================================

void calculateRisk()
{
  // ---------------------------------------------
  // Tilt score
  // 5 degrees = 100%
  // ---------------------------------------------

  float tiltScore =
    (groundTilt / 5.0) * 100.0;

  tiltScore =
    constrain(tiltScore, 0, 100);

  // ---------------------------------------------
  // Vibration score
  // ---------------------------------------------

  float vibrationScore =
    vibrationPercent;

  // ---------------------------------------------
  // Tilt-rate score
  // 1 degree/sec = 100%
  // ---------------------------------------------

  float tiltRateScore =
    (tiltRate / 1.0) * 100.0;

  tiltRateScore =
    constrain(tiltRateScore, 0, 100);

  // ---------------------------------------------
  // Combined risk
  // ---------------------------------------------

  riskScore =
    (0.45 * tiltScore) +
    (0.35 * vibrationScore) +
    (0.20 * tiltRateScore);

  riskScore =
    constrain(riskScore, 0, 100);

  // ---------------------------------------------
  // Status
  // ---------------------------------------------

  if (riskScore < 30)
  {
    groundStatus = "SAFE";
  }
  else if (riskScore < 60)
  {
    groundStatus = "CAUTION";
  }
  else if (riskScore < 80)
  {
    groundStatus = "WARNING";
  }
  else
  {
    groundStatus = "CRITICAL";
  }
}

// =====================================================
// TELEGRAM CRITICAL ALERT
// =====================================================

void checkTelegramAlert()
{
  // CRITICAL condition
  if (riskScore >= 80)
  {
    criticalCount++;

    Serial.print("Critical count: ");
    Serial.println(criticalCount);

    // Require several consecutive critical readings
    if (
      criticalCount >= CRITICAL_COUNT_REQUIRED &&
      !criticalAlertSent
    )
    {
      String message = "";

      message += "🚨 CRITICAL GROUND ALERT 🚨\n\n";

      message += "Possible ground instability detected.\n\n";

      message += "Ground Tilt: ";
      message += String(groundTilt, 2);
      message += "°\n";

      message += "Vibration: ";
      message += String(vibrationPercent, 1);
      message += "%\n";

      message += "Tilt Rate: ";
      message += String(tiltRate, 2);
      message += " °/s\n";

      message += "Risk Score: ";
      message += String(riskScore, 1);
      message += "/100\n\n";

      message += "STATUS: CRITICAL";

      bool sent =
        bot.sendMessage(
          CHAT_ID,
          message,
          ""
        );

      if (sent)
      {
        Serial.println("================================");
        Serial.println("TELEGRAM CRITICAL ALERT SENT!");
        Serial.println("================================");

        criticalAlertSent = true;
      }
      else
      {
        Serial.println("Telegram alert failed.");
      }
    }
  }
  else
  {
    // Reset consecutive critical counter
    criticalCount = 0;
  }

  // Re-arm the system after risk falls below WARNING
  if (riskScore < 60)
  {
    criticalAlertSent = false;
  }
}

